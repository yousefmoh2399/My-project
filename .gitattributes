# Unity YAML merge settings
*.cs diff=csharp text
*.cginc text
*.shader text
*.hlsl text
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text
*.md text eol=lf
*.asset text merge=unityyamlmerge
*.unity text merge=unityyamlmerge
*.prefab text merge=unityyamlmerge
*.mat text merge=unityyamlmerge

